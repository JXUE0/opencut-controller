{
  "name": "opencut-controller",
  "version": "1.31.0",
  "type": "module",
  "mcpName": "io.github.JXUE0/opencut-controller",
  "description": "Professional MCP server for video editing automation with OpenCut",
  "license": "MIT",
  "author": "JXUE0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JXUE0/opencut-controller.git"
  },
  "bugs": {
    "url": "https://github.com/JXUE0/opencut-controller/issues"
  },
  "homepage": "https://github.com/JXUE0/opencut-controller#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "video-editing",
    "opencut",
    "automation",
    "playwright"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "opencut-controller": "dist/index.mjs"
  },
  "files": [
    "dist",
    "assets",
    "scripts",
    "mcp-server.json",
    "README.md",
    "README.es.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.59.1",
    "zod": "^4.4.1"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
