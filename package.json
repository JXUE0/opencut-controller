{
  "name": "opencut-controller",
  "version": "1.29.3",
  "mcpName": "OpenCut Controller",
  "description": "Professional MCP server for video editing automation with OpenCut",
  "license": "MIT",
  "author": "JXUE0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JXUE0/opencut-controller.git"
  },
  "bugs": {
    "url": "https://github.com/JXUE0/opencut-controller/issues"
  },
  "homepage": "https://github.com/JXUE0/opencut-controller#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "video-editing",
    "opencut",
    "automation",
    "playwright"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "opencut-controller": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "assets",
    "scripts",
    "mcp-server.json",
    "README.md",
    "README.es.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --minify --dts",
    "dev": "tsup src/index.ts --format esm --watch",
    "postinstall": "playwright install chromium",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.59.1",
    "zod": "^4.4.1"
  }
}
